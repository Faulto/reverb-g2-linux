+# OpenCV 5 split the old calib3d/features2d modules into calib + geometry and
+# features.  Probe core first so we can select the component names supported by
+# the installed major version while retaining OpenCV 4 compatibility.
+find_package(OpenCV QUIET COMPONENTS core CONFIG)
+unset(OpenCV_LIBS)
+unset(OpenCV_LIBRARIES)
+if(OpenCV_VERSION_MAJOR GREATER_EQUAL 5)
+	find_package(
+		OpenCV
+		COMPONENTS core calib geometry highgui imgproc imgcodecs features video
 		CONFIG
-	)
+		)
+else()
+	find_package(
+		OpenCV
+		COMPONENTS core calib3d highgui imgproc imgcodecs features2d video
+		CONFIG
+		)
+endif()
 find_package(Libusb1 MODULE)
 find_package(JPEG MODULE)
 find_package(realsense2 CONFIG)
