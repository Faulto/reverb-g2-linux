 namespace {
+double
+session_env_double(const char *name, double fallback, double minimum, double maximum)
+{
+	const char *raw = std::getenv(name);
+	if (raw == nullptr || raw[0] == '\0') {
+		return fallback;
+	}
+	char *end = nullptr;
+	double value = std::strtod(raw, &end);
+	return end != raw && *end == '\0' && std::isfinite(value) && value >= minimum && value <= maximum
+	           ? value
+	           : fallback;
+}
+
+bool
+session_env_bool(const char *name, bool fallback)
+{
+	const char *raw = std::getenv(name);
+	if (raw == nullptr || raw[0] == '\0') {
+		return fallback;
+	}
+	if (strcmp(raw, "1") == 0 || strcasecmp(raw, "true") == 0 || strcasecmp(raw, "yes") == 0 ||
+	    strcasecmp(raw, "on") == 0) {
+		return true;
+	}
+	if (strcmp(raw, "0") == 0 || strcasecmp(raw, "false") == 0 || strcasecmp(raw, "no") == 0 ||
+	    strcasecmp(raw, "off") == 0) {
+		return false;
+	}
+	return fallback;
+}
