+bool
+session_position_finite(const struct xrt_vec3 &p)
+{
+	return std::isfinite(p.x) && std::isfinite(p.y) && std::isfinite(p.z);
+}
+
+bool
+session_orientation_finite(const struct xrt_quat &q)
+{
+	return std::isfinite(q.x) && std::isfinite(q.y) && std::isfinite(q.z) && std::isfinite(q.w);
+}
+
+double
+session_up_y(const struct xrt_quat &q)
+{
+	return 1.0 - 2.0 * ((double)q.x * q.x + (double)q.z * q.z);
+}
+
+bool
+session_position_in_bounds(const WorldReanchorGuard &guard, const struct xrt_vec3 &p)
+{
+	if (!guard.have_session_anchor || !session_position_finite(p)) {
+		return false;
+	}
+	const double dx = (double)p.x - guard.session_anchor.x;
+	const double dy = (double)p.y - guard.session_anchor.y;
+	const double dz = (double)p.z - guard.session_anchor.z;
+	return std::abs(dx) <= guard.half_width_m && std::abs(dz) <= guard.half_depth_m &&
+	       dy >= -guard.eye_height_m && dy <= guard.headroom_m;
+}
+
+bool
+session_position_horizontal_in_bounds(const WorldReanchorGuard &guard, const struct xrt_vec3 &p)
+{
+	if (!guard.have_session_anchor || !session_position_finite(p)) {
+		return false;
+	}
+	const double dx = (double)p.x - guard.session_anchor.x;
+	const double dz = (double)p.z - guard.session_anchor.z;
+	return std::abs(dx) <= guard.half_width_m && std::abs(dz) <= guard.half_depth_m;
+}
+
+bool
+session_position_vertical_recoverable(const WorldReanchorGuard &guard, const struct xrt_vec3 &p)
+{
+	if (!guard.have_session_anchor || !session_position_finite(p)) {
+		return false;
+	}
+	const double dy = (double)p.y - guard.session_anchor.y;
+	return dy >= -guard.eye_height_m - guard.height_recovery_margin_m &&
+	       dy <= guard.headroom_m + guard.height_recovery_margin_m;
+}
