   OpticalFlowInput::Ptr partial_frame;
 
+  void apply_runtime_overrides() {
+    const char* raw_recall = std::getenv("BASALT_FEATURE_RECALL");
+    if (raw_recall == nullptr || raw_recall[0] == '\0') return;
+
+    const string mode(raw_recall);
+    if (mode == "off" || mode == "false" || mode == "0") {
+      vio_config.optical_flow_recall_enable = false;
+      vio_config.optical_flow_recall_all_cams = false;
+    } else if (mode == "front" || mode == "true" || mode == "1") {
+      vio_config.optical_flow_recall_enable = true;
+      vio_config.optical_flow_recall_all_cams = false;
+    } else if (mode == "all") {
+      vio_config.optical_flow_recall_enable = true;
+      vio_config.optical_flow_recall_all_cams = true;
+    } else {
+      std::cerr << "Ignoring invalid BASALT_FEATURE_RECALL='" << mode << "'\n";
+      return;
+    }
+    std::cout << "Basalt landmark recall: " << mode
+              << " (experimental; recalled patches persist for this tracker session)\n";
+  }
+
   explicit Implementation(const vit::Config *config) : show_gui(config->show_ui), cam_count(config->cam_count) {
     cout << "Basalt with cam_count=" << cam_count << ", show_gui=" << show_gui << "\n";
 
