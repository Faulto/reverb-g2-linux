From 6adcb70400db666bdb186a97887bea7f799242da Mon Sep 17 00:00:00 2001
From: reverb-g2 contributors <noreply@localhost>
Date: Wed, 23 Sep 2026 12:00:00 +1000
Subject: [PATCH] nvkms: port the Reverb G2 8-bpc workaround to 615

NVIDIA 615 refactored nvDpyGetOutputColorFormatInfo(), so the 610 patches
which correct an undefined DisplayPort EDID depth and force the exact Reverb
G2 to 8 bpc no longer apply without offsets and fuzz.

Preserve their behavior against the 615 source layout. An EDID depth of zero
means undefined, not 6 bpc, so do not clamp the maximum in that case. For the
exact Reverb G2 manufacturer and product IDs, also raise the RGB444 minimum to
8 bpc. Other DisplayPort devices keep the existing 6-bpc minimum.

Base: NVIDIA open-gpu-kernel-modules 615.71.09
      61dcc93722ecb418bb5f2e00923f05b4b8051dd1
---
 src/nvidia-modeset/src/nvkms-dpy.c | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/src/nvidia-modeset/src/nvkms-dpy.c b/src/nvidia-modeset/src/nvkms-dpy.c
index 3815fe8..0b20eee 100644
--- a/src/nvidia-modeset/src/nvkms-dpy.c
+++ b/src/nvidia-modeset/src/nvkms-dpy.c
@@ -3712,7 +3712,8 @@ NvKmsDpyOutputColorFormatInfo nvDpyGetOutputColorFormatInfo(
 
             if (pDpyEvo->parsedEdid.valid &&
                 info->input.isDigital && info->version >= NVT_EDID_VER_1_4) {
-                if (info->input.u.digital.bpc < 8) {
+                if (info->input.u.digital.bpc != 0 &&
+                    info->input.u.digital.bpc < 8) {
                     colorFormatsInfo.rgb444.maxBpc =
                         NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_6;
                     colorFormatsInfo.yuv444.maxBpc =
@@ -3724,8 +3725,19 @@ NvKmsDpyOutputColorFormatInfo nvDpyGetOutputColorFormatInfo(
                     colorFormatsInfo.yuv444.maxBpc = maxBpc;
                 }
 
-                colorFormatsInfo.rgb444.minBpc =
-                    NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_6;
+                /*
+                 * The HP Reverb G2 leaves EDID color depth undefined. It
+                 * requires 8 bpc even though generic DP sinks may use 6.
+                 */
+                if ((info->manuf_id == 0x0E22) &&
+                    (info->product_id == 0x36C1) &&
+                    (info->input.u.digital.bpc == 0)) {
+                    colorFormatsInfo.rgb444.minBpc =
+                        NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_8;
+                } else {
+                    colorFormatsInfo.rgb444.minBpc =
+                        NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_6;
+                }
                 if (colorFormatsInfo.yuv444.maxBpc !=
                         NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_UNKNOWN) {
                      colorFormatsInfo.yuv444.minBpc =
-- 
