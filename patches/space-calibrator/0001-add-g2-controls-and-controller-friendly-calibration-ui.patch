+namespace {
+
+struct G2ActionState {
+    pid_t pid = -1;
+    int outputFd = -1;
+    std::string output;
+    std::string description;
+    bool finished = false;
+    bool succeeded = false;
+    double floorDeadline = 0.0;
+};
+
+G2ActionState g_g2Action;
+
+std::string FindG2ActionHelper()
+{
+    const char* configured = std::getenv("REVERB_G2_ACTION_HELPER");
+    if (configured != nullptr && configured[0] != '\0') {
+        return configured;
+    }
+
+    const char* xdgBin = std::getenv("XDG_BIN_HOME");
+    if (xdgBin != nullptr && xdgBin[0] != '\0') {
+        return std::string(xdgBin) + "/reverb-g2-vr-action";
+    }
+
+    const char* home = std::getenv("HOME");
+    if (home != nullptr && home[0] != '\0') {
+        return std::string(home) + "/.local/bin/reverb-g2-vr-action";
+    }
+
+    return "reverb-g2-vr-action";
+}
+
+void AppendG2ActionOutput(const char* data, size_t size)
+{
+    constexpr size_t maxOutputBytes = 12000;
+    g_g2Action.output.append(data, size);
+    if (g_g2Action.output.size() > maxOutputBytes) {
+        g_g2Action.output.erase(0, g_g2Action.output.size() - maxOutputBytes);
+    }
+}
+
+void DrainG2ActionOutput()
+{
+    if (g_g2Action.outputFd < 0) {
+        return;
+    }
+
+    char buffer[1024];
+    while (true) {
+        const ssize_t count = read(g_g2Action.outputFd, buffer, sizeof(buffer));
+        if (count > 0) {
+            AppendG2ActionOutput(buffer, static_cast<size_t>(count));
+            continue;
+        }
+        if (count == 0) {
+            close(g_g2Action.outputFd);
+            g_g2Action.outputFd = -1;
+        }
+        if (count < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+            constexpr char message[] = "Unable to read action output.\n";
+            AppendG2ActionOutput(message, sizeof(message) - 1);
+            close(g_g2Action.outputFd);
+            g_g2Action.outputFd = -1;
+        }
+        break;
+    }
+}
+
+void StartG2Action(const char* action, const char* description)
+{
+    if (g_g2Action.pid > 0) {
+        return;
+    }
+
+    g_g2Action.output.clear();
+    g_g2Action.description = description;
+    g_g2Action.finished = false;
+    g_g2Action.succeeded = false;
+
+    int outputPipe[2];
+    if (pipe(outputPipe) != 0) {
+        g_g2Action.output = std::string("Unable to create action pipe: ") + std::strerror(errno);
+        g_g2Action.finished = true;
+        return;
+    }
+
+    const int flags = fcntl(outputPipe[0], F_GETFL, 0);
+    if (flags >= 0) {
+        fcntl(outputPipe[0], F_SETFL, flags | O_NONBLOCK);
+    }
+
+    const std::string helper = FindG2ActionHelper();
+    posix_spawn_file_actions_t fileActions;
+    posix_spawn_file_actions_init(&fileActions);
+    posix_spawn_file_actions_adddup2(&fileActions, outputPipe[1], STDOUT_FILENO);
+    posix_spawn_file_actions_adddup2(&fileActions, outputPipe[1], STDERR_FILENO);
+    posix_spawn_file_actions_addclose(&fileActions, outputPipe[0]);
+    posix_spawn_file_actions_addclose(&fileActions, outputPipe[1]);
+
+    char* argv[] = {
+        const_cast<char*>(helper.c_str()),
+        const_cast<char*>(action),
+        nullptr,
+    };
+    pid_t childPid = -1;
+    const int spawnError = posix_spawnp(
+        &childPid, helper.c_str(), &fileActions, nullptr, argv, environ);
+    posix_spawn_file_actions_destroy(&fileActions);
+    close(outputPipe[1]);
+
+    if (spawnError != 0) {
+        close(outputPipe[0]);
+        g_g2Action.output = std::string("Unable to start reverb-g2-vr-action: ") +
+                            std::strerror(spawnError);
+        g_g2Action.finished = true;
+        return;
+    }
+
+    g_g2Action.pid = childPid;
+    g_g2Action.outputFd = outputPipe[0];
+}
+
+void UpdateG2Action()
+{
+    if (g_g2Action.floorDeadline > 0.0 && glfwGetTime() >= g_g2Action.floorDeadline) {
+        g_g2Action.floorDeadline = 0.0;
+        StartG2Action("set-floor", "Setting floor");
+    }
+
+    if (g_g2Action.pid <= 0) {
+        return;
+    }
+
+    DrainG2ActionOutput();
+    int status = 0;
+    const pid_t result = waitpid(g_g2Action.pid, &status, WNOHANG);
+    if (result == g_g2Action.pid) {
+        DrainG2ActionOutput();
+        if (g_g2Action.outputFd >= 0) {
+            close(g_g2Action.outputFd);
+            g_g2Action.outputFd = -1;
+        }
+        g_g2Action.pid = -1;
+        g_g2Action.finished = true;
+        g_g2Action.succeeded = WIFEXITED(status) && WEXITSTATUS(status) == 0;
+    } else if (result < 0) {
+        constexpr char message[] = "Unable to monitor action process.\n";
+        AppendG2ActionOutput(message, sizeof(message) - 1);
+        if (g_g2Action.outputFd >= 0) {
+            close(g_g2Action.outputFd);
+            g_g2Action.outputFd = -1;
+        }
+        g_g2Action.pid = -1;
+        g_g2Action.finished = true;
+        g_g2Action.succeeded = false;
+    }
+}
+
+float G2ButtonHeight()
+{
+    return std::max(64.0f, ImGui::GetTextLineHeightWithSpacing() * 3.0f);
+}
+
+void BuildG2ControlsTab()
+{
+    const bool actionRunning = g_g2Action.pid > 0;
+    const bool floorCountdown = g_g2Action.floorDeadline > 0.0;
+    const float width = ImGui::GetContentRegionAvail().x;
+    const float buttonHeight = G2ButtonHeight();
+
+    ImGui::TextWrapped(
+        "These controls use the same checked commands as the desktop Reverb G2 control panel.");
+    ImGui::Spacing();
+
+    ImGui::BeginDisabled(actionRunning || floorCountdown);
+    if (ImGui::Button("Start modded Beat Saber", ImVec2(width, buttonHeight))) {
+        StartG2Action("start-modded", "Starting modded Beat Saber");
+    }
+    ImGui::Spacing();
+    if (ImGui::Button("Set floor (10 second countdown)", ImVec2(width, buttonHeight))) {
+        g_g2Action.output.clear();
+        g_g2Action.description = "Waiting to set floor";
+        g_g2Action.finished = false;
+        g_g2Action.succeeded = false;
+        g_g2Action.floorDeadline = glfwGetTime() + 10.0;
+    }
+    ImGui::EndDisabled();
+
+    if (floorCountdown) {
+        const int remaining = std::max(
+            1, static_cast<int>(std::ceil(g_g2Action.floorDeadline - glfwGetTime())));
+        ImGui::Spacing();
+        ImGui::TextWrapped(
+            "Stand upright at play-centre and keep your head still. Setting the floor in %d...",
+            remaining);
+        if (ImGui::Button("Cancel floor reset", ImVec2(width, buttonHeight))) {
+            g_g2Action.floorDeadline = 0.0;
+            g_g2Action.description.clear();
+        }
+    } else if (actionRunning) {
+        ImGui::Spacing();
+        ImGui::TextWrapped("%s...", g_g2Action.description.c_str());
+    } else if (g_g2Action.finished) {
+        ImGui::Spacing();
+        if (g_g2Action.succeeded) {
+            ImGui::TextColored(ImVec4(0.3f, 0.9f, 0.3f, 1.0f), "%s succeeded.",
+                               g_g2Action.description.c_str());
+        } else {
+            ImGui::TextColored(ImVec4(1.0f, 0.35f, 0.3f, 1.0f), "%s failed.",
+                               g_g2Action.description.c_str());
+        }
+    }
+
+    if (!g_g2Action.output.empty()) {
+        ImGui::Spacing();
+        ImGui::Separator();
+        ImGui::TextWrapped("%s", g_g2Action.output.c_str());
+    }
+}
+
